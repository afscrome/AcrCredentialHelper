<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>docker-credential-acr</AssemblyName>
    <ApplicationIcon>acr-credential-helper.ico</ApplicationIcon>
    <RootNamespace>AlexCrome.Acr.CredentialHelper</RootNamespace>
    <Features>runtime-async=on</Features>    
  </PropertyGroup>

  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Required: Azure SDK diagnostics reach the logger through EventSource (AzureEventSourceLogForwarder). -->
    <EventSourceSupport>true</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
  
    <!-- Cross-platform RIDs we publish for -->
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AlexCrome.Acr.CredentialHelper.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'osx-x64'">
    <!-- The runtime's GSS descriptor is unaligned; Apple's chained fixups cannot encode it.
         https://github.com/dotnet/runtime/issues/129601 -->
    <LinkerArg Include="-Wl,-no_fixup_chains" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Containers.ContainerRegistry" Version="1.4.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Identity.Broker" Version="1.7.0" />
    <PackageReference Include="Azure.ResourceManager.ResourceGraph" Version="1.1.1" />
    <PackageReference Include="Microsoft.Extensions.Azure" Version="1.14.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0-rc.2.26504.105" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-rc.2.26504.105" />
  </ItemGroup>

</Project>
