<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <!-- Version is stamped by packaging/pack-msix.ps1. -->
  <Identity
    Name="AlexCrome.AcrCredentialHelper"
    Publisher="CN=AlexCrome"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>ACR Credential Helper</DisplayName>
    <PublisherDisplayName>Alex Crome</PublisherDisplayName>
    <Description>Docker credential helper for Azure Container Registry using Microsoft Entra broker authentication.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-GB" />
  </Resources>

  <Applications>
    <Application Id="DockerCredentialAcr" Executable="docker-credential-acr.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="ACR Credential Helper"
        Description="Docker credential helper for Azure Container Registry"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias" Executable="docker-credential-acr.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="docker-credential-acr.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
